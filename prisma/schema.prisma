generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  Customer
  Reviewer
  Merchant
  Staff
  Admin
}

enum ApplicationStatus {
  Draft
  Pending
  Accepted
  Rejected
}

enum ApplicationType {
  Merchant
}

enum MerchantStatus {
  Active
  Inactive
  Suspended
}

enum OrderType {
  Online
  Offline
}

enum PaymentMethod {
  COD
  Cash
  BankTransfer
  SePay
}

enum OrderStatus {
  Pending
  Accepted
  Preparing
  Ready
  Delivering
  Rejected
  Completed
  NotReceived
  Cancelled
}

enum OrderPaymentStatus {
  Unpaid
  Pending
  Paid
  Rejected
}

enum BillStatus {
  Requested
  PendingCustomerConfirmation
  Confirmed
  Rejected
}

enum ReviewerApplicationStatus {
  Pending
  Accepted
  Rejected
}

enum CampaignDiscountType {
  Percentage
  FixedAmount
}

enum NotificationType {
  Order
  Payment
  Application
  Review
  Affiliate
  System
}

enum SupportTicketStatus {
  Open
  InProgress
  WaitingForMerchant
  Resolved
  Closed
}

enum SupportTicketPriority {
  Low
  Normal
  High
  Urgent
}

enum SupportTicketCategory {
  Orders
  Delivery
  Payment
  Menu
  Account
  Other
}

enum CheckInStatus {
  Pending
  Verified
  Rejected
  Expired
  Disputed
}

enum CheckInMethod {
  OrderQr
  DirectQr
  CustomerCode
}

enum MerchantAcquisitionEventStatus {
  Valid
  Disputed
  Cancelled
}

enum MerchantVerificationStatus {
  Unverified
  PendingVerification
  VerifiedBusiness
  UnderReview
  Suspended
  Removed
}

enum MerchantListingVisibility {
  Public
  Hidden
}

enum GemStatus {
  HiddenGem
  RisingGem
  HallOfFame
}

enum IncidentType {
  FoodSafety
  Hygiene
  Fraud
  WrongInformation
  BadService
  Other
}

enum IncidentSeverity {
  Low
  Medium
  High
  Critical
}

enum IncidentStatus {
  Open
  UnderReview
  Resolved
  Rejected
}

enum MerchantClaimStatus {
  Pending
  UnderReview
  Approved
  Rejected
}

enum MerchantRemovalStatus {
  Pending
  UnderReview
  Approved
  Rejected
}

enum RestaurantSuggestionStatus {
  Pending
  UnderReview
  Approved
  Rejected
  Published
}

enum FunnelEventType {
  Register
  ActiveUser
  RestaurantView
  Save
  Visit
  CheckIn
  VerifiedVisit
  RepeatVisit
}

enum MonetizationFeeType {
  VerifiedVisitFee
  CampaignFee
  PremiumAnalytics
  OptionalOrderFee
}

enum RebalancingStatus {
  Running
  Completed
  Failed
}

enum AffiliateTransactionStatus {
  Pending
  Failed
  Success
  Commissioned
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  phoneNumber  String?
  fullName     String
  avatarUrl    String?
  role         UserRole @default(Customer)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer               Customer?
  merchant               Merchant?
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  applications           Application[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  createdSupportTickets  SupportTicket[]      @relation("SupportTicketCreator")
  assignedSupportTickets SupportTicket[]      @relation("SupportTicketAssignee")
  supportMessages        SupportMessage[]

  @@map("users")
}

model Customer {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferredRestaurantTypes String[] @default([])
  preferredMainDishTypes   String[] @default([])
  preferredCategoryIds     String[] @default([])
  preferredPriceRanges     String[] @default([])

  orders               Order[]
  wishlists            Wishlist[]
  reviews              Review[]
  reviewerApplications ReviewerApplication[]
  affiliateLinks       AffiliateLink[]
  earningTransactions  ReviewerEarningTransaction[]
  affiliateClicks      AffiliateClick[]
  checkIns             CheckIn[]
  acquisitionEvents    MerchantAcquisitionEvent[]
  bookings             Booking[]
  reviewerPoints       Int                          @default(0)
  reviewerRank         String                       @default("Bronze")
  gemPoints            Int                          @default(0)
  contributionRank     String                       @default("Bronze")
  pointTransactions    ReviewerPointTransaction[]
  merchantViews        MerchantView[]
  customerCode         String?                      @unique
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([customerCode])
  @@map("customers")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Application {
  id              String            @id @default(uuid())
  applicantUserId String
  type            ApplicationType   @default(Merchant)
  status          ApplicationStatus @default(Pending)

  name           String
  description    String?
  restaurantType String
  mainDishType   String
  priceRange     String
  email          String
  phone          String
  logoUrl        String?
  openingHours   String
  address        String
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)

  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicant User              @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  menus     ApplicationMenu[]

  @@index([applicantUserId])
  @@index([status])
  @@map("applications")
}

model ApplicationMenu {
  id            String @id @default(uuid())
  applicationId String

  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  imageUrl    String?
  category    String
  cuisine     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_menus")
}

model Merchant {
  id     String @id @default(uuid())
  userId String @unique

  name           String
  description    String?
  restaurantType String
  mainDishType   String
  priceRange     String

  email        String
  phone        String
  address      String
  country      String  @default("VN")
  city         String?
  area         String?
  openingHours String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  logoUrl String?

  bankCode            String?
  bankAccountNumber   String?
  bankAccountName     String?
  bankTransferEnabled Boolean @default(false)

  rating      Decimal @default(0) @db.Decimal(3, 2)
  reviewCount Int     @default(0)
  totalViews  Int     @default(0)

  strengthIndex      Decimal    @default(0) @db.Decimal(10, 4)
  underratedScore    Decimal    @default(0) @db.Decimal(10, 4)
  recommendationRank Int?
  gemStatus          GemStatus?
  lastRebalancedAt   DateTime?

  status                MerchantStatus             @default(Active)
  verificationStatus    MerchantVerificationStatus @default(Unverified)
  listingVisibility     MerchantListingVisibility  @default(Public)
  safetySuppressed      Boolean                    @default(false)
  safetySuppressedUntil DateTime?
  safetyRiskScore       Decimal                    @default(0) @db.Decimal(10, 4)
  foods                 Food[]
  orders                Order[]
  wishlists             Wishlist[]
  reviews               Review[]
  affiliateLinks        AffiliateLink[]
  campaigns             Campaign[]
  checkIns              CheckIn[]
  acquisitionEvents     MerchantAcquisitionEvent[]
  bookings              Booking[]
  views                 MerchantView[]
  supportTickets        SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([name])
  @@index([recommendationRank])
  @@index([underratedScore])
  @@index([latitude, longitude])
  @@index([country, city, area])
  @@map("merchants")
}

model Category {
  id          String   @id @default(uuid())
  parentId    String?
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  foodCategories FoodCategory[]

  @@unique([parentId, name])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Food {
  id            String   @id @default(uuid())
  merchantId    String
  name          String
  description   String?
  cuisine       String?
  price         Decimal  @db.Decimal(12, 2)
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  isCombo       Boolean  @default(false)
  originalPrice Decimal? @db.Decimal(12, 2)
  servingSize   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  categories       FoodCategory[]
  toppings         FoodTopping[]
  orderDetails     OrderDetail[]
  comboItems       ComboItem[]    @relation("ComboParent")
  includedInCombos ComboItem[]    @relation("ComboChild")

  @@index([merchantId])
  @@index([isAvailable])
  @@index([isCombo])
  @@index([name])
  @@map("foods")
}

model ComboItem {
  id        String   @id @default(uuid())
  comboId   String
  foodId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  combo Food @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  food  Food @relation("ComboChild", fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([comboId, foodId])
  @@index([comboId])
  @@index([foodId])
  @@map("combo_items")
}

model FoodCategory {
  foodId     String
  categoryId String
  createdAt  DateTime @default(now())

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([foodId, categoryId])
  @@index([categoryId])
  @@map("food_categories")
}

model FoodTopping {
  id       String  @id @default(uuid())
  foodId   String
  name     String
  price    Decimal @default(0) @db.Decimal(12, 2)
  isActive Boolean @default(true)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  orderDetailToppings OrderDetailTopping[]

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, name])
  @@index([foodId])
  @@index([isActive])
  @@map("food_toppings")
}

model Order {
  id         String @id @default(uuid())
  customerId String
  merchantId String

  affiliateLinkId String?
  campaignId      String?

  name          String
  orderType     OrderType
  paymentMethod PaymentMethod
  status        OrderStatus        @default(Pending)
  paymentStatus OrderPaymentStatus @default(Unpaid)

  notes             String?
  deliveryAddress   String?
  deliveryLatitude  Decimal? @db.Decimal(10, 7)
  deliveryLongitude Decimal? @db.Decimal(10, 7)

  subtotal           Decimal @db.Decimal(12, 2)
  discount           Decimal @default(0) @db.Decimal(12, 2)
  finalPrice         Decimal @db.Decimal(12, 2)
  reviewerCommission Decimal @default(0) @db.Decimal(12, 2)

  rejectionReason String?

  orderedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  preparingAt  DateTime?
  readyAt      DateTime?
  deliveringAt DateTime?
  rejectedAt   DateTime?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  earningTransaction   ReviewerEarningTransaction?
  affiliateTransaction AffiliateTransaction?

  details           OrderDetail[]
  bill              Bill?
  review            Review?
  checkIn           CheckIn?
  acquisitionEvents MerchantAcquisitionEvent[]

  @@index([customerId])
  @@index([merchantId])
  @@index([affiliateLinkId])
  @@index([status])
  @@index([paymentStatus])
  @@index([orderedAt])
  @@index([campaignId])
  @@map("orders")
}

model OrderDetail {
  id      String @id @default(uuid())
  orderId String
  foodId  String

  foodNameSnapshot String
  quantity         Int
  unitPrice        Decimal        @db.Decimal(12, 2)
  notes            String?
  lineTotal        Decimal        @db.Decimal(12, 2)
  reviewDetails    ReviewDetail[]

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  food Food @relation(fields: [foodId], references: [id], onDelete: Restrict)

  toppings OrderDetailTopping[]

  @@index([orderId])
  @@index([foodId])
  @@map("order_details")
}

model OrderDetailTopping {
  id            String @id @default(uuid())
  orderDetailId String
  toppingId     String

  toppingNameSnapshot String
  priceSnapshot       Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Cascade)

  topping FoodTopping @relation(fields: [toppingId], references: [id], onDelete: Restrict)

  @@index([orderDetailId])
  @@index([toppingId])
  @@map("order_detail_toppings")
}

model Bill {
  id      String @id @default(uuid())
  orderId String @unique

  method PaymentMethod
  status BillStatus

  amount Decimal @db.Decimal(12, 2)

  evidenceUrl     String?
  transferContent String?
  sepayReference  String? @unique

  bankCodeSnapshot        String?
  bankAccountSnapshot     String?
  bankAccountNameSnapshot String?

  requestedAt         DateTime?
  merchantConfirmedAt DateTime?
  customerConfirmedAt DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("bills")
}

model Wishlist {
  customerId String
  merchantId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([customerId, merchantId])
  @@index([merchantId])
  @@map("wishlists")
}

model Review {
  id         String  @id @default(uuid())
  customerId String
  merchantId String
  orderId    String? @unique
  checkInId  String? @unique

  rating   Int
  content  String?
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  checkIn CheckIn? @relation(fields: [checkInId], references: [id], onDelete: Restrict)

  details ReviewDetail[]

  @@index([customerId])
  @@index([merchantId])
  @@index([createdAt])
  @@map("reviews")
}

model ReviewDetail {
  id            String @id @default(uuid())
  reviewId      String
  orderDetailId String

  rating  Int?
  content String?

  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  orderDetail OrderDetail @relation(fields: [orderDetailId], references: [id], onDelete: Restrict)

  @@unique([reviewId, orderDetailId])
  @@index([orderDetailId])
  @@map("review_details")
}

model ReviewerApplication {
  id         String @id @default(uuid())
  customerId String

  status ReviewerApplicationStatus @default(Pending)

  motivation String
  experience String?

  facebookUrl    String?
  instagramUrl   String?
  tiktokUrl      String?
  youtubeUrl     String?
  otherSocialUrl String?

  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@map("reviewer_applications")
}

model AffiliateLink {
  id         String @id @default(uuid())
  reviewerId String
  merchantId String

  linkCode String @unique

  clickCount       Int     @default(0)
  successfulOrders Int     @default(0)
  totalEarnings    Decimal @default(0) @db.Decimal(12, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewer Customer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  clicks                AffiliateClick[]
  orders                Order[]
  bookings              Booking[]
  affiliateTransactions AffiliateTransaction[]
  checkIns              CheckIn[]
  acquisitionEvents     MerchantAcquisitionEvent[]

  @@unique([reviewerId, merchantId])
  @@index([reviewerId])
  @@index([merchantId])
  @@index([isActive])
  @@map("affiliate_links")
}

model AffiliateClick {
  id              String  @id @default(uuid())
  affiliateLinkId String
  customerId      String?

  ipHash    String?
  userAgent String?

  clickedAt DateTime @default(now())

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([affiliateLinkId])
  @@index([customerId])
  @@index([clickedAt])
  @@map("affiliate_clicks")
}

model ReviewerEarningTransaction {
  id         String  @id @default(uuid())
  reviewerId String
  orderId    String? @unique
  bookingId  String? @unique

  amount        Decimal @db.Decimal(12, 2)
  earningsAfter Decimal @db.Decimal(12, 2)

  type   String
  reason String?

  createdAt DateTime @default(now())

  reviewer Customer @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@index([createdAt])
  @@map("reviewer_earning_transactions")
}

model AffiliateTransaction {
  id              String                     @id @default(uuid())
  affiliateLinkId String
  orderId         String?                    @unique
  bookingId       String?                    @unique
  status          AffiliateTransactionStatus @default(Pending)
  commission      Decimal?                   @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  affiliateLink AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  booking       Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([affiliateLinkId])
  @@index([status])
  @@map("affiliate_transactions")
}

model ReviewerPointTransaction {
  id          String   @id @default(uuid())
  reviewerId  String
  amount      Int
  pointsAfter Int
  type        String
  reason      String?
  referenceId String?
  rewardKey   String?  @unique
  createdAt   DateTime @default(now())

  reviewer Customer @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@index([createdAt])
  @@map("reviewer_point_transactions")
}

model Campaign {
  id         String @id @default(uuid())
  merchantId String

  name        String
  description String?
  code        String  @unique

  discountType  CampaignDiscountType
  discountValue Decimal              @db.Decimal(12, 2)

  minimumOrderAmount Decimal  @default(0) @db.Decimal(12, 2)
  maximumDiscount    Decimal? @db.Decimal(12, 2)

  startAt DateTime
  endAt   DateTime

  usageLimit                   Int?
  usedCount                    Int     @default(0)
  maxUsagePerUser              Int     @default(1)
  verifiedVisitLimit           Int?
  maxVerifiedVisitsPerCustomer Int     @default(1)
  isGlobal                     Boolean @default(false)
  isNewUserOnly                Boolean @default(false)
  isActive                     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  orders            Order[]
  checkIns          CheckIn[]
  acquisitionEvents MerchantAcquisitionEvent[]

  @@index([merchantId])
  @@index([isActive])
  @@index([startAt])
  @@index([endAt])
  @@map("campaigns")
}

model CheckIn {
  id         String  @id @default(uuid())
  orderId    String? @unique
  customerId String
  merchantId String
  qrToken    String? @unique

  rewardBenefit    String?
  notes            String?
  source           String?
  campaignId       String?
  bookingId        String?
  affiliateLinkId  String?
  checkInMethod    CheckInMethod @default(OrderQr)
  suspicious       Boolean       @default(false)
  suspiciousReason String?
  disputedAt       DateTime?

  generatedAt DateTime      @default(now())
  expiresAt   DateTime?
  checkedInAt DateTime?
  verifiedAt  DateTime?
  latitude    Decimal?      @db.Decimal(10, 7)
  longitude   Decimal?      @db.Decimal(10, 7)
  status      CheckInStatus @default(Pending)

  order            Order?                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer         Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchant         Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  campaign         Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  booking          Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  affiliateLink    AffiliateLink?            @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  acquisitionEvent MerchantAcquisitionEvent?
  review           Review?

  @@index([customerId])
  @@index([merchantId])
  @@index([checkedInAt])
  @@index([status])
  @@index([merchantId, customerId, checkedInAt])
  @@index([suspicious, status])
  @@map("check_ins")
}

model MerchantAcquisitionEvent {
  id                 String                         @id @default(uuid())
  merchantId         String
  customerId         String
  checkInId          String                         @unique
  campaignId         String?
  orderId            String?
  bookingId          String?
  affiliateLinkId    String?
  source             String?
  verificationMethod CheckInMethod
  status             MerchantAcquisitionEventStatus @default(Valid)
  occurredAt         DateTime                       @default(now())
  createdAt          DateTime                       @default(now())

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  checkIn       CheckIn        @relation(fields: [checkInId], references: [id], onDelete: Restrict)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  booking       Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  @@index([merchantId, occurredAt])
  @@index([merchantId, status, occurredAt])
  @@index([customerId, occurredAt])
  @@index([source])
  @@map("merchant_acquisition_events")
}

model MerchantIncident {
  id               String           @id @default(uuid())
  merchantId       String
  reporterUserId   String
  type             IncidentType
  severity         IncidentSeverity @default(Medium)
  status           IncidentStatus   @default(Open)
  description      String
  evidenceUrls     String[]         @default([])
  adminDecision    String?
  resolution       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([merchantId, status])
  @@index([merchantId, severity, createdAt])
  @@index([reporterUserId])
  @@map("merchant_incidents")
}

model MerchantClaim {
  id                String              @id @default(uuid())
  merchantId        String
  submittedByUserId String
  status            MerchantClaimStatus @default(Pending)
  evidenceUrls      String[]            @default([])
  decision          String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([merchantId, status])
  @@index([submittedByUserId])
  @@map("merchant_claims")
}

model MerchantRemovalRequest {
  id                String                @id @default(uuid())
  merchantId        String
  submittedByUserId String
  status            MerchantRemovalStatus @default(Pending)
  reason            String
  decision          String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([merchantId, status])
  @@index([submittedByUserId])
  @@map("merchant_removal_requests")
}

model RestaurantSuggestion {
  id                  String                     @id @default(uuid())
  name                String
  address             String
  category            String?
  recommendedDish     String?
  description         String?
  images              String[]                   @default([])
  reason              String
  submittedByUserId   String?
  status              RestaurantSuggestionStatus @default(Pending)
  reviewedByUserId    String?
  publishedMerchantId String?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([submittedByUserId])
  @@map("restaurant_suggestions")
}

model FunnelEvent {
  id         String          @id @default(uuid())
  eventType  FunnelEventType
  userId     String?
  merchantId String?
  sessionKey String?
  metadata   Json?
  occurredAt DateTime        @default(now())

  @@index([eventType, occurredAt])
  @@index([merchantId, eventType, occurredAt])
  @@index([userId, eventType, occurredAt])
  @@map("funnel_events")
}

model MonetizationFeePolicy {
  id          String              @id @default(uuid())
  feeType     MonetizationFeeType
  amount      Decimal?
  currency    String              @default("VND")
  isActive    Boolean             @default(false)
  effectiveAt DateTime            @default(now())
  metadata    Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([feeType, isActive])
  @@map("monetization_fee_policies")
}

model Notification {
  id     String @id @default(uuid())
  userId String

  type    NotificationType
  title   String
  message String

  referenceId   String?
  referenceType String?

  isRead Boolean @default(false)

  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model SupportTicket {
  id              String                @id @default(uuid())
  merchantId      String
  createdByUserId String
  assignedStaffId String?
  category        SupportTicketCategory @default(Other)
  priority        SupportTicketPriority @default(Normal)
  status          SupportTicketStatus   @default(Open)
  subject         String
  description     String
  orderId         String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  merchant      Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdBy     User             @relation("SupportTicketCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedStaff User?            @relation("SupportTicketAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([merchantId, status])
  @@index([assignedStaffId, status])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id            String   @id @default(uuid())
  ticketId      String
  senderUserId  String
  message       String
  attachmentUrl String?
  isInternal    Boolean  @default(false)
  createdAt     DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderUserId])
  @@map("support_messages")
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  actorRole   UserRole?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model RebalancingRun {
  id                  String            @id @default(uuid())
  status              RebalancingStatus @default(Running)
  merchantCount       Int               @default(0)
  increasedVisibility Int               @default(0)
  decreasedVisibility Int               @default(0)
  unchangedVisibility Int               @default(0)
  startedAt           DateTime          @default(now())
  completedAt         DateTime?
  errorMessage        String?

  @@index([startedAt])
  @@index([status])
  @@map("rebalancing_runs")
}

enum BookingStatus {
  Pending
  Accepted
  Rejected
  Cancelled
  Completed
}

model Booking {
  id              String        @id @default(uuid())
  customerId      String
  merchantId      String
  affiliateLinkId String?
  bookingAt       DateTime
  partySize       Int
  note            String?
  status          BookingStatus @default(Pending)
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  affiliateLink        AffiliateLink?              @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  affiliateTransaction AffiliateTransaction?
  earningTransaction   ReviewerEarningTransaction?
  checkIns             CheckIn[]
  acquisitionEvents    MerchantAcquisitionEvent[]

  @@index([customerId])
  @@index([merchantId])
  @@index([affiliateLinkId])
  @@index([status])
  @@map("bookings")
}

enum MerchantTrafficSource {
  Recommendation
  Search
  Map
  Sponsored
  Affiliate
  Direct
}

model MerchantView {
  id         String                @id @default(uuid())
  merchantId String
  customerId String?
  source     MerchantTrafficSource @default(Direct)
  createdAt  DateTime              @default(now())

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([customerId])
  @@index([source])
  @@index([createdAt])
  @@map("merchant_views")
}
