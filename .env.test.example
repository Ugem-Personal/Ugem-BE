# Optional override. The database name MUST end with `_test`.
# If omitted, `npm run test:e2e` derives `<current_database>_test` from DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugem_db_test

# Use non-production values only.
E2E_SEPAY_WEBHOOK_API_KEY=e2e-sepay-key-with-at-least-32-characters
