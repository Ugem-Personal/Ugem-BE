{
  "info": {
    "_postman_id": "e2259355-2b25-4a54-a533-0a7e10ca0001",
    "name": "UGem UAT",
    "description": "Contract-aligned local UAT requests. Run 00, then logins, then the merchant/customer golden flow in order.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health/ready" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('ready 200', () => pm.response.to.have.status(200));",
        "const body = pm.response.json();",
        "pm.test('standard envelope', () => { pm.expect(body.success).to.eql(true); pm.expect(body.traceId).to.be.a('string'); });"
      ] } }]
    },
    {
      "name": "01 - Login roles",
      "item": [
        { "name": "Login Admin", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{uatPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('admin login 200', () => pm.response.to.have.status(200));", "pm.environment.set('adminToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login Staff", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{uatPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('staff login 200', () => pm.response.to.have.status(200));", "pm.environment.set('staffToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login Customer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{uatPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer login 200', () => pm.response.to.have.status(200));", "pm.environment.set('customerToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login Reviewer", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{reviewerEmail}}\",\n  \"password\": \"{{uatPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('reviewer login 200', () => pm.response.to.have.status(200));", "pm.environment.set('reviewerToken', pm.response.json().data.accessToken);"] } }] },
        { "name": "Login Merchant", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{merchantEmail}}\",\n  \"password\": \"{{uatPassword}}\"\n}" }, "url": "{{baseUrl}}/auth/login" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('merchant login 200', () => pm.response.to.have.status(200));", "pm.environment.set('merchantToken', pm.response.json().data.accessToken);"] } }] }
      ]
    },
    {
      "name": "02 - Admin security",
      "item": [
        { "name": "Admin lists Staff", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/staff?pageIndex=1&pageSize=20" } },
        { "name": "Admin reads audit logs", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/audit-logs?pageIndex=1&pageSize=20" } },
        { "name": "Customer is forbidden from Admin", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/admin/staff" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer forbidden 403', () => pm.response.to.have.status(403));"] } }] }
      ]
    },
    {
      "name": "03 - Order golden flow",
      "item": [
        { "name": "Merchant gets seeded food", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{merchantToken}}" }], "url": "{{baseUrl}}/foods" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('food list 200', () => pm.response.to.have.status(200));", "const foods = pm.response.json().data;", "pm.expect(foods.length).to.be.above(0);", "pm.environment.set('foodId', foods[0].id);"] } }] },
        { "name": "Customer creates COD order", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Đơn Postman UAT\",\n  \"paymentMethod\": \"COD\",\n  \"orderType\": \"Online\",\n  \"deliveryAddress\": \"1 Nguyễn Huệ, Quận 1\",\n  \"foods\": [{ \"foodId\": \"{{foodId}}\", \"quantity\": 1, \"foodToppingIds\": [] }]\n}" }, "url": "{{baseUrl}}/orders" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('created 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.environment.set('orderId', body.data.orderId);", "pm.test('canonical order id', () => { pm.expect(body.data.orderId).to.be.a('string'); pm.expect(body.data).not.to.have.property('id'); });"] } }] },
        { "name": "Merchant accepts order", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Accepted\" }" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" } },
        { "name": "Merchant prepares order", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Preparing\" }" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" } },
        { "name": "Merchant marks ready", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Ready\" }" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" } },
        { "name": "Merchant starts delivery", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{merchantToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Delivering\" }" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" } },
        { "name": "Customer completes order", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{ \"status\": \"Completed\" }" }, "url": "{{baseUrl}}/orders/{{orderId}}/status" } },
        { "name": "Customer reads paginated orders", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }], "url": "{{baseUrl}}/orders/mine?pageIndex=1&pageSize=10" }, "event": [{ "listen": "test", "script": { "exec": ["pm.test('pagination metadata', () => { const body = pm.response.json(); pm.expect(body.meta.pageIndex).to.eql(1); pm.expect(body.meta.totalItems).to.be.a('number'); });"] } }] }
      ]
    }
  ]
}
